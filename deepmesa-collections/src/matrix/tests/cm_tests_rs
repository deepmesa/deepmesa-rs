#[test]
fn test_foo() {
    let rows = 12;
    let cols = 12;
    let mut m: Matrix<u8> = Matrix::simd_optimized(rows, cols);
    m.fill(3);
    assert_eq!(m.rmd.row_pad, 52);
    assert_eq!(m.cmd.col_pad, 52);
    let step = 64;
    println!(
        "RMLEN: {}, rm_len / step = {}, rm_len % step = {}",
        m.rmd.rm_len,
        m.rmd.rm_len / step,
        m.rmd.rm_len % step
    );

    for idx in (0..m.rmd.rm_len).step_by(step) {
        println!(
            "IDX: {} - {}, Rem: {}",
            idx,
            idx + step - 1,
            m.rmd.rm_len - (idx + step)
        );
    }
}
